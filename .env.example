# Copy to .env.local for local development, or set in your hosting provider.
# All three are PUBLIC values (safe in the browser). Leave them empty to run in
# single-user local mode with no backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# SERVER-ONLY secrets are NOT set here. Set them as Supabase function secrets:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
#   supabase secrets set CRON_SECRET=<random string> APP_ORIGIN=https://your-app.example
#   supabase secrets set ANTHROPIC_API_KEY=...   # optional, only for AI grading
